@* About / author. Redesigned: identity, work and reachability. The post list is deliberately gone -
   this page is about the person, not the archive (the archive is at /archive/).
   PERSONALITY RUNDOWN: the "who i am" prose is a clearly-marked placeholder until the author
   supplies it; the structure below is final. *@
<SitePage Site=@Site Title=@PageTitle Description=@PageDescription Canonical=@CanonicalPath
          SceneData=@SceneData PostsJson=@PostsJson>
    <section class="sec wrap split split-7-5" style="align-items:start;padding-block-end:1rem">
        <div>
            <p class="eyebrow"><b>01</b>@Author.Handle</p>
            <h1 class="mt-4" style="font-size:var(--fs-xl);max-width:22ch">@PageTitle</h1>
            @if (!string.IsNullOrEmpty(Author.Bio))
            {
                <p class="mt-4" style="color:var(--ink-dim);max-width:60ch;font-size:var(--fs-md)">@Author.Bio</p>
            }
            <p class="mt-4" style="color:var(--ink-faint);max-width:60ch;font-size:var(--fs-sm)">
                This blog is where I work things out in public: systems, tooling, and the occasional
                detour into colour, type and cars.
            </p>
        </div>
        <div class="sticky-side">
            <div class="panel">
                <p class="panel-head"><span>at a glance</span><span>02</span></p>
                <div style="padding:1.25rem;display:flex;gap:2.5rem">
                    <div>
                        <span class="metric" data-count="@YearsWriting">@YearsWriting</span>
                        <span class="metric-label">years writing</span>
                    </div>
                    <div>
                        <span class="metric" data-count="@TotalWords">@TotalWords</span>
                        <span class="metric-label">words</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="wrap split split-7-5" style="align-items:start">
        <div>
            <h2 class="eyebrow"><b>03</b>who i am</h2>

            @* ==== PLACEHOLDER: personality rundown goes here ==== *@
            <div class="about-note" data-placeholder="personality-rundown">
                <b>awaiting personality rundown.</b> The structure below is final and the sections are
                wired; the copy lands in this block the moment you send it. Nothing here invents facts
                about you in the meantime.
            </div>

            <div style="display:grid;gap:1.5rem;max-width:62ch">
                <div data-about-section="how-i-work">
                    <h3 style="font-size:var(--fs-md);font-weight:600">how i work</h3>
                    <p class="mt-2" style="color:var(--ink-dim);font-size:var(--fs-sm)">
                        [placeholder] What the day looks like, what problems I reach for first, how I
                        decide when something is done.
                    </p>
                </div>
                <div data-about-section="what-i-build">
                    <h3 style="font-size:var(--fs-md);font-weight:600">what i build</h3>
                    <p class="mt-2" style="color:var(--ink-dim);font-size:var(--fs-sm)">
                        [placeholder] The stack I live in, the kind of systems I enjoy, and the ones I
                        avoid on purpose.
                    </p>
                </div>
                <div data-about-section="outside-the-editor">
                    <h3 style="font-size:var(--fs-md);font-weight:600">outside the editor</h3>
                    <p class="mt-2" style="color:var(--ink-dim);font-size:var(--fs-sm)">
                        [placeholder] The rest of it: cars, colour, whatever keeps the curiosity fed.
                    </p>
                </div>
            </div>
        </div>

        <div class="sticky-side">
            <div class="panel">
                <p class="panel-head"><span>reach me</span><span>04</span></p>
                <div style="padding:1rem">
                    <div class="reach-list">
                        <a href="@(B)/contact/">contact form <span>easiest</span></a>
                        @if (Author.Website is { } website)
                        {
                            <a href="@website" rel="me">website <span>@Host(website)</span></a>
                        }
                        @foreach (var (network, handle) in Author.Social)
                        {
                            var host = network is "x" ? "x.com" : network + ".com";
                            <a href="https://@(host)/@handle" rel="me">@network <span>@handle</span></a>
                        }
                        <a href="@(B)/rss.xml">rss <span>@(B)/rss.xml</span></a>
                        <a href="@(B)/atom.xml">atom <span>@(B)/atom.xml</span></a>
                    </div>
                    <p class="form-note" style="margin-block-start:1rem">
                        Replies go to whatever address you leave in the form; nothing is sold or added
                        to a list.
                    </p>
                </div>
            </div>
        </div>
    </section>
</SitePage>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required AuthorRecord Author { get; set; }
    [Parameter] public required IReadOnlyList<PostSummary> Posts { get; set; }
    /// <summary>Lets the /about/ route carry its own canonical instead of borrowing the author's.</summary>
    [Parameter] public string? CanonicalOverride { get; set; }
    [Parameter] public string? TitleOverride { get; set; }
    [Parameter] public string? DescriptionOverride { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    private string B => Site.BasePath;
    private string CanonicalPath => CanonicalOverride ?? $"/authors/{Author.Handle}/";
    private string PageTitle => TitleOverride ?? Author.Name;
    private string PageDescription => DescriptionOverride ?? (string.IsNullOrWhiteSpace(Author.Bio)
        ? $"{Author.Name} writes about systems, software and the tools in between at {Site.Title}."
        : Author.Bio);

    // identity stats only; the post list lives on /archive/ and the index
    private int YearsWriting => Posts.Count == 0 ? 0 : Posts.Select(p => p.Published.Year).Distinct().Count();
    private int TotalWords => Posts.Sum(p => p.ReadTimeMinutes) * 200;

    private static string Host(string url) => System.Uri.TryCreate(url, System.UriKind.Absolute, out var u)
        ? u.Host.Replace("www.", "")
        : url;
}
