@* Hairline post card: mono title-block line, title, clamped description, tag pills. *@
<article class="group border border-line rounded bg-surface hover:border-accent transition-colors duration-150 flex flex-col">
    <a href="@(Base + Post.Url)" class="flex flex-col gap-3 p-5 flex-1">
        <p class="title-block flex items-center gap-2 flex-wrap">
            <span>@Post.Published.ToString("yyyy-MM-dd")</span>
            <span class="text-line-soft">|</span>
            <span>@Post.ReadTimeMinutes min</span>
            @if (Post.Featured)
            {
                <span class="text-gold">◆</span>
            }
        </p>
        <h3 class="text-lg font-semibold leading-snug group-hover:text-accent transition-colors duration-150">@Post.Title</h3>
        <p class="text-sm text-muted leading-relaxed line-clamp-2">@Post.Description</p>
    </a>
    @if (Post.Tags.Count > 0)
    {
        <div class="px-5 pb-4 pt-1 flex flex-wrap gap-2">
            @foreach (var tag in Post.Tags)
            {
                <a href="@(Base)/tags/@tag/" class="font-mono text-[0.6875rem] tracking-wide text-muted border border-line-soft rounded-sm px-2 py-0.5 hover:text-accent hover:border-accent transition-colors duration-150">#@tag</a>
            }
        </div>
    }
</article>

@code {
    [Parameter] public required PostSummary Post { get; set; }
    [Parameter] public string Base { get; set; } = "";
}
