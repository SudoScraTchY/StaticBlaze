@* StaticBlaze shell. Renders the whole document. The generator supplies every value as a parameter.

   Rubric notes (Leonxlnx/taste-skill):
     - 4.11 Page Theme Lock: dark-only. There is no theme toggle and no per-section inversion.
     - 4.2  Color Consistency Lock: one accent token, --accent, everywhere.
     - no em-dashes anywhere in rendered copy.
   The stage div paints the CSS atmosphere immediately, so there is depth before three.js loads and
   something to see if it never does. *@
<!DOCTYPE html>
<html lang="@Site.Language" dir="@Dir" data-base="@B" data-anim="pending" data-scene="pending">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Title · @Site.Title</title>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@Combined(Site.Url, Canonical)" />
    @if (OgImage is not null)
    {
        <meta property="og:image" content="@Combined(Site.Url, OgImage)" />
    }
    <meta property="og:type" content="@OgType" />
    <meta property="og:site_name" content="@Site.Title" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Combined(Site.Url, Canonical)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#06070d" />
    <link rel="alternate" type="application/rss+xml" title="@Site.Title" href="@Combined(Site.Url, "/rss.xml")" />
    <link rel="alternate" type="application/atom+xml" title="@Site.Title" href="@Combined(Site.Url, "/atom.xml")" />
    <link rel="stylesheet" href="@(B)/assets/site.css" />
    @if (SceneData is not null)
    {
        <script type="application/json" id="scene-data">@((MarkupString)SceneData)</script>
    }
    @if (JsonLd is not null)
    {
        <script type="application/ld+json">@((MarkupString)JsonLd)</script>
    }
</head>
<body>
    <a class="skip" href="#main">skip to content</a>

    @* the WebGL stage sits behind everything and never takes pointer events *@
    <div class="stage" data-stage aria-hidden="true"><canvas data-stage-canvas></canvas></div>
    <div class="grain" aria-hidden="true"></div>
    <div data-veil aria-hidden="true"
         style="position:fixed;inset:0;z-index:85;display:none;pointer-events:none"></div>
    <div data-spotlight aria-hidden="true"
         style="position:fixed;z-index:1;left:0;top:0;width:44rem;height:44rem;pointer-events:none;border-radius:999px;background:radial-gradient(circle,var(--accent-soft),transparent 62%)"></div>

    @if (ShowRail)
    {
        <div class="rail" aria-hidden="true"><i data-rail></i></div>
    }

    <header class="cockpit">
        <div class="cockpit-in">
            <a href="@(B)/" class="brand" aria-label="@Site.Title, home">
                <svg class="brand-mark" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                    <path d="M16 2.5 28.5 9.5v13L16 29.5 3.5 22.5v-13L16 2.5Z" />
                    <path d="M16 9.5 22 13v6l-6 3.5L10 19v-6l6-3.5Z" />
                    <circle cx="16" cy="16" r="1.6" fill="currentColor" stroke="none" />
                </svg>
                <span class="brand-word">@Wordmark</span>
            </a>
            <nav class="nav" aria-label="primary">
                @foreach (var link in Site.Nav)
                {
                    <a href="@(B + link.Href)" aria-current="@(IsActive(link.Href) ? "page" : null)">@link.Label</a>
                }
            </nav>
            <button type="button" class="cmd-trigger" data-cmd-open aria-label="open search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
                </svg>
                <span class="kbd">/</span>
            </button>
        </div>
        <nav class="nav-mobile wrap" aria-label="mobile">
            @foreach (var link in Site.Nav)
            {
                <a href="@(B + link.Href)" aria-current="@(IsActive(link.Href) ? "page" : null)">@link.Label</a>
            }
        </nav>
    </header>

    @* command palette: a real search surface, focusable, escapable, keyboard driven *@
    <div class="cmd" data-cmd hidden>
        <div class="cmd-box" role="dialog" aria-modal="true" aria-label="search">
            <div class="cmd-field">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" style="color:var(--ink-faint)">
                    <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
                </svg>
                <label class="sr-only" for="cmd-input">search posts</label>
                <input id="cmd-input" type="search" data-cmd-input placeholder="search the archive" autocomplete="off" />
            </div>
            <ul class="cmd-list" role="listbox" aria-label="results" data-cmd-list></ul>
            <p class="cmd-hint"><span>enter to open</span><span>esc to close</span><span>/ to focus</span></p>
            <p class="sr-only" aria-live="polite" data-cmd-live></p>
        </div>
    </div>

    <div class="shell">
        <main id="main" @(ShowRail ? "data-article" : "")>
            @ChildContent
        </main>

        <footer class="foot">
            <div class="wrap foot-in">
                <span>@("@")@Wordmark · @Site.Description</span>
                <span class="foot-links">
                    <a href="@(B)/posts/">index</a>
                    <a href="@(B)/archive/">archive</a>
                    <a href="@(B)/tags/">tags</a>
                    <a href="@(B)/contact/">contact</a>
                    <a href="@(B)/rss.xml">rss</a>
                    <a href="@(B)/atom.xml">atom</a>
                    <a href="@(B)/admin/">admin</a>
                </span>
            </div>
        </footer>
    </div>

    @* data the 3D layer reads. Real posts, so the field is the archive. *@
    <script type="application/json" data-posts>@((MarkupString)PostsJson)</script>

    @* GSAP classic scripts load first (defer runs before module scripts), then the motion module. *@
    <script defer src="@(B)/assets/vendor/gsap.min.js"></script>
    <script defer src="@(B)/assets/vendor/ScrollTrigger.min.js"></script>
    <script defer src="@(B)/assets/vendor/ScrollToPlugin.min.js"></script>
    <script defer src="@(B)/assets/vendor/Flip.min.js"></script>
    <script type="module" src="@(B)/assets/site.js"></script>
    <script type="module" src="@(B)/assets/motion.js"></script>
</body>
</html>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required string Title { get; set; }
    [Parameter] public required string Description { get; set; }
    [Parameter] public required string Canonical { get; set; }
    [Parameter] public string? OgType { get; set; } = "website";
    [Parameter] public string? OgImage { get; set; }
    [Parameter] public string? JsonLd { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>JSON payload for the 3D field: the published posts, plus the current post when relevant.</summary>
    [Parameter] public string? SceneData { get; set; }

    /// <summary>Mirror of the post summaries for the search palette, kept independent of SceneData.</summary>
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    /// <summary>Shows the reading rail and marks the article root. Post pages only.</summary>
    [Parameter] public bool ShowRail { get; set; }

    private string B => Site.BasePath;
    private string Wordmark => string.IsNullOrWhiteSpace(Site.Wordmark) ? Site.Title.ToLowerInvariant() : Site.Wordmark;

    private string Dir => (Site.Language ?? "en").Trim().ToLowerInvariant() switch
    {
        "fa" or "fa-ir" or "ar" or "he" or "ur" => "rtl",
        _ => "ltr",
    };

    private static string Combined(string baseUrl, string path) =>
        baseUrl.TrimEnd('/') + (path.StartsWith('/') ? path : "/" + path);

    private bool IsActive(string href) =>
        href == "/" ? Canonical == "/" : Canonical.StartsWith(href, StringComparison.OrdinalIgnoreCase);
}
