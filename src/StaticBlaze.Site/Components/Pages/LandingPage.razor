@* Home. The 3D stage sits behind the hero, so the first thing a visitor sees is the archive rendered
   as a field, not a list. Every number on this page is computed from the manifest. *@
<SitePage Site=@Site Title="Home" Description=@Site.Description Canonical=@CanonicalPath JsonLd=@JsonLd
          SceneData=@SceneData PostsJson=@PostsJson>
    @if (Page == 1)
    {
        <section class="hero-sec">
            <div class="hero-fx" data-hero-fx aria-hidden="true"><canvas data-hero-canvas></canvas></div>
            <div class="wrap hero-ov">
                <i class="ov-rule" aria-hidden="true"></i>
                <span class="ov-side" aria-hidden="true">sudoScratchy · github · est. 2026</span>

                <p class="eyebrow"><b>01</b>@HeroKicker</p>

                <h1 class="ov-title" data-hero-title aria-label="@FullTitle">
                    @for (var i = 0; i < HeroLines.Count; i++)
                    {
                        var ghost = i == HeroLines.Count - 1 && HeroLines.Count > 1;
                        <span class="ov-line@(ghost ? " ov-line--ghost" : "")" aria-hidden="true">
                            @foreach (var word in HeroLines[i].Split(' '))
                            {
                                <span class="ov-word">@foreach (var ch in word) { <span class="ov-char">@ch</span> }</span>
                                @(" ")
                            }
                        </span>
                    }
                </h1>

                <p class="hero-sub" data-hero-stagger>@HeroSub</p>

                <div class="ov-ticker" data-hero-stagger>
                    <div class="ov-ticker-track" data-ov-ticker>
                        <span class="ov-ticker-run">@TickerRun</span>
                        <span class="ov-ticker-run" aria-hidden="true">@TickerRun</span>
                    </div>
                </div>

                <div class="hero-cta" data-hero-stagger>
                    <a class="btn-ov" href="@(B)/posts/" data-magnet="6">
                        <span>read the latest</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                    </a>
                    <a class="link-ov" href="@(B)/archive/" data-magnet="4">
                        <span>browse the archive</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                    </a>
                    <span class="form-note">press <span class="kbd">/</span> to search anywhere</span>
                </div>

                <div class="ov-readout" data-hero-stagger aria-label="post metrics">
                    <div>
                        <span class="metric" data-count="@PostsPublished">@PostsPublished</span>
                        <span class="metric-label">posts</span>
                    </div>
                    <div>
                        <span class="metric" data-count="@TagCount">@TagCount</span>
                        <span class="metric-label">tags</span>
                    </div>
                    <div>
                        <span class="metric" data-count="@YearsWriting">@YearsWriting</span>
                        <span class="metric-label">years writing</span>
                    </div>
                    <div>
                        <span class="metric" data-count="@TotalWords">@TotalWords</span>
                        <span class="metric-label">words</span>
                    </div>
                </div>

                <div data-hero-line style="height:2px;background:linear-gradient(90deg,var(--lajvard),var(--accent),transparent)"></div>
                @* a quiet data rail: something to read besides the headline, and it is all true *@
                <aside class="hero-meta" data-hero-stagger aria-label="site readout">
                    <span>since <b>@FirstPostYear</b></span>
                    <span>last post <b>@LastPostDate</b></span>
                    <span>engine <b>.NET 10</b></span>
                    <span>host <b>github pages</b></span>
                </aside>
            </div>
        </section>

        @* the field: tags as a drifting horizontal surface, pinned while you scroll past it *@
        @if (TagCount > 0)
        {
            <section class="sec" data-pin-field style="overflow:hidden;padding-block:2.5rem;border-block:1px solid var(--edge)">
                <div class="wrap" style="margin-block-end:1rem">
                    <p class="eyebrow"><b>02</b>the field</p>
                </div>
                <div data-pin-track style="display:flex;gap:.5rem;padding-inline:clamp(1rem,4vw,3rem);width:max-content">
                    @foreach (var tag in TopTags)
                    {
                        <a class="chip" href="@(B)/tags/@tag.Slug/" style="min-height:38px;padding-inline:1rem">
                            #@tag.Slug <span style="color:var(--ink-faint);margin-inline-start:.4rem">@tag.Count</span>
                        </a>
                    }
                    <a class="chip" href="@(B)/tags/" style="min-height:38px;padding-inline:1rem;color:var(--accent);border-color:var(--accent)">all tags</a>
                </div>
            </section>
        }

        @if (Featured.Count > 0)
        {
            <section class="sec wrap">
                <p class="eyebrow mb-6"><b>03</b>lead</p>
                <div class="grid-nodes">
                    @for (var i = 0; i < Featured.Count; i++)
                    {
                        <PostCard Post=@Featured[i] Base=@B Index=@(i + 1) />
                    }
                </div>
            </section>
        }

        <h2 class="eyebrow wrap" style="padding-block:0 .5rem"><b>04</b>latest</h2>
    }
    else
    {
        <section class="sec wrap">
            <h1 class="eyebrow"><b>04</b>latest · page @Page</h1>
        </section>
    }

    <section class="wrap" style="padding-block-end:clamp(3rem,7vw,6rem)">
        <div class="grid-nodes">
            @for (var i = 0; i < Posts.Count; i++)
            {
                <PostCard Post=@Posts[i] Base=@B Index=@(Featured.Count + i + 1) />
            }
        </div>
        <Pagination Page=@Page TotalPages=@TotalPages BasePath=@($"{B}/") />
    </section>
</SitePage>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required int Page { get; set; }
    [Parameter] public required int TotalPages { get; set; }
    [Parameter] public required IReadOnlyList<PostSummary> Posts { get; set; }
    [Parameter] public required IReadOnlyList<PostSummary> Featured { get; set; }
    [Parameter] public required IReadOnlyList<PostSummary> AllPosts { get; set; }
    [Parameter] public required int TagCount { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";
    [Parameter] public IReadOnlyList<TermCount> TopTags { get; set; } = [];

    private string CanonicalPath => Page <= 1 ? "/" : $"/page/{Page}/";
    private string B => Site.BasePath;

    private string HeroKicker => string.IsNullOrWhiteSpace(Site.Hero.Kicker) ? Site.Title : Site.Hero.Kicker;
    private IReadOnlyList<string> HeroLines => Site.Hero.Lines.Count > 0 ? Site.Hero.Lines : [Site.Title];
    private string HeroSub => string.IsNullOrWhiteSpace(Site.Hero.Sub) ? Site.Description : Site.Hero.Sub;

    private int PostsPublished => AllPosts.Count;
    private int YearsWriting => AllPosts.Count == 0 ? 0 : AllPosts.Select(p => p.Published.Year).Distinct().Count();
    private int TotalWords => AllPosts.Sum(p => p.ReadTimeMinutes) * 200;
    private string FirstPostYear => AllPosts.Count == 0 ? "-" : AllPosts.Min(p => p.Published.Year).ToString();
    private string LastPostDate => AllPosts.Count == 0 ? "-" : AllPosts.Max(p => p.Published).ToString("yyyy-MM-dd");

    private string FullTitle => string.Join(" ", HeroLines);

    private static readonly string[] TickerItems =
    [
        "static to the last byte",
        "markdown in, html out",
        ".NET 10 generator",
        "github actions → github pages",
        "webgl archive graph",
        "zero trackers",
        "rss · atom · sitemap",
    ];

    private string TickerRun => string.Join(" · ", TickerItems);

    private string JsonLd => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = Site.Title,
        ["description"] = Site.Description,
        ["url"] = Site.Url,
    }, StaticBlazeJson.Options);
}
