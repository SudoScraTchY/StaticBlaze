@* The full index: every post, filterable by tag, category and free text, entirely client side over
   the same manifest the generator already emits. Works with JavaScript off as a plain grouped list. *@
<SitePage Site=@Site Title="Index" Description=@PageDescription Canonical="/posts/"
          SceneData=@SceneData PostsJson=@PostsJson>
    <section class="sec wrap" style="padding-block-end:2rem">
        <p class="eyebrow"><b>01</b>index</p>
        <h1 class="mt-4" style="font-size:var(--fs-xl);max-width:22ch">Every post, filterable.</h1>
        <p class="mt-3" style="color:var(--ink-dim);max-width:56ch">
            @Posts.Count entries. Filter by tag or category, or type to search titles and summaries.
            With JavaScript off this page still lists everything, grouped by category.
        </p>
    </section>

    <section class="wrap split split-8-4" style="padding-block-end:1.5rem">
        <div>
            <label class="field-label" for="idx-q">filter</label>
            <input id="idx-q" class="input" type="search" data-idx-q placeholder="title, summary, tag" autocomplete="off" />
        </div>
        <div class="sticky-side">
            <p class="field-label">tags</p>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem" data-idx-tags>
                <button type="button" class="chip" data-tag="*" data-active="true">all</button>
                @foreach (var t in Tags)
                {
                    <button type="button" class="chip" data-tag="@t.Slug">#@t.Slug <span style="color:var(--ink-faint);margin-inline-start:.3rem">@t.Count</span></button>
                }
            </div>
            <p class="field-label" style="margin-block-start:1.25rem">categories</p>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem" data-idx-cats>
                <button type="button" class="chip" data-cat="*" data-active="true">all</button>
                @foreach (var c in Categories)
                {
                    <button type="button" class="chip" data-cat="@c.Slug">@c.Title</button>
                }
            </div>
        </div>
    </section>

    <section class="wrap" style="padding-block-end:clamp(3rem,7vw,6rem)">
        <p class="form-note mb-4" data-idx-count aria-live="polite">@Posts.Count shown</p>

        <ul class="rows" data-idx-list>
            @{ var n = 0; }
            @foreach (var group in Posts.GroupBy(p => p.Category ?? "uncategorised").OrderBy(g => g.Key))
            {
                <li style="border:0;padding-block:1.5rem 0" data-group>
                    <p class="eyebrow"><b>@group.Key</b></p>
                </li>
                @foreach (var post in group.OrderByDescending(p => p.Published))
                {
                    n++;
                    <li data-row
                        data-tags="@string.Join(' ', post.Tags)"
                        data-cat="@post.Category"
                        data-q="@($"{post.Title} {post.Description} {string.Join(' ', post.Tags)}")">
                        <a class="row" href="@(B + post.Url)">
                            <span class="row-idx">@n.ToString("000")</span>
                            <span class="row-date">@post.Published.ToString("yyyy-MM-dd")</span>
                            <span class="row-title">@post.Title</span>
                            <span class="row-min">@post.ReadTimeMinutes min</span>
                        </a>
                    </li>
                }
            }
        </ul>

        <p data-idx-empty hidden style="color:var(--ink-dim);padding-block:2rem">
            No entries match that filter. Clearing the tag and category chips resets the list.
        </p>
    </section>
</SitePage>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required IReadOnlyList<PostSummary> Posts { get; set; }
    [Parameter] public required IReadOnlyList<TermCount> Tags { get; set; }
    [Parameter] public required IReadOnlyList<TermCount> Categories { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    private string B => Site.BasePath;
    private string PageDescription => $"Every post on {Site.Title} in one filterable index. {Posts.Count} entries; filter by tag, category or free text, no JavaScript required to read them all.";
}
