@page "/posts"
@inject PostService PostSvc

<div class="page-head">
    <div>
        <span class="crumb">admin / posts</span>
        <h1>Posts</h1>
    </div>
    <div class="page-actions">
        <a href="posts/edit" class="btn btn-primary">new post</a>
    </div>
</div>

<div class="mb-5">
    <label for="filter" class="sr-only">filter posts</label>
    <input id="filter" type="search" class="w-full" placeholder="filter by title, slug or tag…" @bind="_filter" />
</div>

@if (Loading)
{
    <p class="empty">loading…</p>
}
else if (_posts.Count == 0)
{
    <p class="empty">Nothing published yet. <a href="posts/edit">Write the first post.</a></p>
}
else if (!Filtered.Any())
{
    <p class="empty">No posts match “@_filter”.</p>
}
else
{
    <ul class="rows">
        @foreach (var post in Filtered)
        {
            <li>
                <a href="@($"posts/edit?file={Uri.EscapeDataString(post.FileName)}")" class="row">
                    <span class="row-date">@post.Frontmatter.Published.ToString("yyyy-MM-dd")</span>
                    <span class="row-title">@post.Frontmatter.Title</span>
                    @if (post.Frontmatter.Draft)
                    {
                        <span class="badge badge-draft">draft</span>
                    }
                    @if (post.Frontmatter.Featured)
                    {
                        <span class="badge">featured</span>
                    }
                    <span class="row-tags">@string.Join(" ", post.Frontmatter.Tags.Select(t => "#" + t))</span>
                </a>
            </li>
        }
    </ul>
    <p class="field-help mt-3">@Filtered.Count() of @_posts.Count posts</p>
}

@code {
    private bool Loading = true;
    private string _filter = "";
    private List<AdminPost> _posts = [];

    private IEnumerable<AdminPost> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? _posts
        : _posts.Where(p => p.Frontmatter.Title.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || p.Frontmatter.Slug.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || string.Join(' ', p.Frontmatter.Tags).Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.Authed) { Nav.NavigateTo("unlock"); return; }
        try { _posts = await PostSvc.ListPostsAsync(); }
        finally { Loading = false; }
    }
}
