@page "/posts/edit"
@inject IJSRuntime JS
@inject PostService Posts
@inject MediaService Media
@inject PreviewRenderer Preview
@implements IAsyncDisposable

@* Layout: the editor owns the width. Title spans the working column, the markdown editor takes
   the rest, and metadata + the parity preview live in the side panel where they do not push the
   writing surface down the page. Save sits in the page header so it is always reachable. *@

<div class="page-head">
    <div>
        <span class="crumb"><a href="posts">posts</a> / @(IsNew ? "new" : "edit")</span>
        <h1>@(IsNew ? "New post" : "Edit post")</h1>
    </div>
    <div class="page-actions">
        @if (_saved is not null)
        {
            <span class="badge @(_saved.StartsWith("error") ? "badge-err" : "badge-ok")">@_saved</span>
        }
        <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveAsync">
            @(Busy ? "committing…" : IsNew ? "create post" : "save")
        </button>
        @if (!IsNew)
        {
            <button type="button" class="btn btn-danger" disabled="@Busy" @onclick="DeleteAsync">delete</button>
        }
        <a href="posts" class="btn">back</a>
    </div>
</div>

@if (_loadError is not null)
{
    <p class="notice notice-err mb-4">@_loadError</p>
}

<div class="editor-layout">
    <div class="editor-main">
        <input id="title" class="input-title" placeholder="Post title" aria-label="post title"
               @bind="_fm.Title" @bind:after="SyncSlug" />

        <div class="editor-frame">
            <div @ref="_editorHost" id="editor-host"></div>
        </div>

        <p class="field-help">
            Preview parity: the markdown above renders through the same pipeline the generator uses.
            The right-hand pane is that render, so what you see is what ships.
        </p>
    </div>

    <aside class="editor-side">
        <section class="card">
            <p class="card-head">metadata</p>
            <div class="card-body field-row">
                <div class="field">
                    <label for="slug">slug</label>
                    <input id="slug" class="font-mono" @bind="_fm.Slug" @bind:after="SlugTouched" />
                </div>
                <div class="field">
                    <label for="category">category</label>
                    <select id="category" @bind="_fm.Category">
                        @foreach (var term in _categories)
                        {
                            <option value="@term.Slug">@term.Title</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="desc">description</label>
                    <input id="desc" @bind="_fm.Description" />
                    <span class="field-help">60–163 characters; the audit gate enforces this.</span>
                </div>
                <div class="field">
                    <label for="tags">tags</label>
                    <input id="tags" class="font-mono" value="@string.Join(", ", _fm.Tags)" @oninput="OnTagsChanged" />
                    <span class="field-help">comma separated, must exist in the taxonomy.</span>
                </div>
                <div class="field-2">
                    <div class="field">
                        <label for="published">published (utc)</label>
                        <input id="published" type="date" value="@_fm.Published.ToString("yyyy-MM-dd")" @oninput="OnPublishedChanged" />
                    </div>
                    <div class="field">
                        <label>flags</label>
                        <label for="draft" class="flex items-center gap-2 normal-case tracking-normal text-sm text-fg">
                            <input id="draft" type="checkbox" @bind="_fm.Draft" /> draft
                        </label>
                        <label for="featured" class="flex items-center gap-2 normal-case tracking-normal text-sm text-fg">
                            <input id="featured" type="checkbox" @bind="_fm.Featured" /> featured
                        </label>
                    </div>
                </div>
            </div>
        </section>

        <section class="card">
            <p class="card-head">live preview</p>
            <div class="card-body post-body text-sm" style="max-height:32rem;overflow-y:auto">
                @((MarkupString)_previewHtml)
            </div>
        </section>
    </aside>
</div>

@code {
    [SupplyParameterFromQuery(Name = "file")] private string? FileName { get; set; }

    private ElementReference _editorHost;
    private IJSObjectReference? _editor;
    private PostFrontmatter _fm = new() { Published = DateTimeOffset.UtcNow, Author = "mehrshad" };
    private string _body = "";
    private string _previewHtml = "";
    private string? _saved;
    private string? _loadError;
    private bool Busy;
    private bool IsNew = true;
    private string _existingFile = "";
    private List<TaxonomyTerm> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.Authed) { Nav.NavigateTo("unlock"); return; }
        _categories = await Posts.GetTermsAsync("categories");
        if (FileName is { } file)
        {
            var post = await Posts.GetPostAsync(file);
            if (post is null) { _loadError = $"{file} not found in the repository."; return; }
            _fm = post.Frontmatter;
            _body = post.Body;
            _existingFile = file;
            IsNew = false;
        }
        _previewHtml = Preview.Render(_body);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _loadError is null)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/adminEditor.js");
            _editor = await module.InvokeAsync<IJSObjectReference>("initEditor", _editorHost, DotNetObjectReference.Create(this), _body);
        }
    }

    private bool _slugTouched;

    // auto-slug from the title while creating, until the slug is hand-edited
    private void SyncSlug()
    {
        if (IsNew && !_slugTouched)
            _fm.Slug = Slugify(_fm.Title);
    }

    private void SlugTouched() => _slugTouched = true;

    private static string Slugify(string title)
    {
        var slug = title.ToLowerInvariant().Replace(' ', '-');
        slug = string.Concat(slug.Select(c => char.IsAsciiLetterOrDigit(c) || c == '-' ? c : '-'));
        while (slug.Contains("--")) slug = slug.Replace("--", "-");
        return slug.Trim('-');
    }

    private void OnTagsChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        _fm.Tags = [.. raw.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)];
    }

    private void OnPublishedChanged(ChangeEventArgs e)
    {
        if (DateTimeOffset.TryParse(e.Value?.ToString(), out var date))
            _fm.Published = date;
    }

    [JSInvokable]
    public async Task<string> UploadImageAsync(byte[] bytes, string contentType)
    {
        var url = await Media.UploadAsync(bytes, contentType);
        return url;
    }

    [JSInvokable]
    public async Task OnMarkdownChangedAsync(string markdown)
    {
        _body = markdown;
        _previewHtml = Preview.Render(markdown);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        Busy = true;
        _saved = null;
        try
        {
            _fm.Modified = DateTimeOffset.UtcNow;
            if (IsNew)
            {
                _existingFile = await Posts.CreatePostAsync(_fm, _body);
                IsNew = false;
                _saved = $"created {_existingFile}";
            }
            else
            {
                await Posts.SavePostAsync(new AdminPost(_existingFile, "", _fm, _body), $"update: {_fm.Slug}");
                _saved = $"saved · {DateTimeOffset.Now:HH:mm:ss}";
            }
        }
        catch (Exception ex)
        {
            _saved = $"error: {ex.Message}";
        }
        finally { Busy = false; }
    }

    private async Task DeleteAsync()
    {
        Busy = true;
        try
        {
            await Posts.DeletePostAsync(new AdminPost(_existingFile, "", _fm, _body));
            Nav.NavigateTo("posts");
        }
        catch (Exception ex)
        {
            _saved = $"error: {ex.Message}";
            Busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_editor is not null)
        {
            try { await _editor.InvokeVoidAsync("destroy"); await _editor.DisposeAsync(); } catch { }
        }
    }
}
