@* Pagination. Keeps the same href contract as before: "/" for page 1, then /page/{n}/. *@
@if (TotalPages > 1)
{
    <nav class="mt-12 flex items-center justify-between gap-4 font-mono text-xs" aria-label="pagination">
        @if (Page > 1)
        {
            <a href="@Href(Page - 1)" class="btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                prev
            </a>
        }
        else
        {
            <span class="btn" style="opacity:.4;cursor:not-allowed" aria-hidden="true">prev</span>
        }

        <span style="color:var(--ink-faint);letter-spacing:.14em">@Page / @TotalPages</span>

        @if (Page < TotalPages)
        {
            <a href="@Href(Page + 1)" class="btn">
                next
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </a>
        }
        else
        {
            <span class="btn" style="opacity:.4;cursor:not-allowed" aria-hidden="true">next</span>
        }
    </nav>
}

@code {
    [Parameter] public required int Page { get; set; }
    [Parameter] public required int TotalPages { get; set; }
    [Parameter] public required string BasePath { get; set; }

    private string Href(int page) => page <= 1 ? BasePath : $"{BasePath.TrimEnd('/')}/page/{page}/";
}
