@* A post as an instrument node. Index number in zafaran, mono metadata, hairline edge, tilt on hover.
   No emoji, no rounded-card-with-left-border, no drop shadow: depth is a lighter surface plus a glow. *@
<article class="node" data-tilt data-reveal>
    <span class="node-spine" aria-hidden="true"></span>
    <a href="@(Base + Post.Url)" class="node-body" style="text-decoration:none;color:inherit">
        <p class="node-meta">
            <span class="node-idx">@Index.ToString("000")</span>
            <i aria-hidden="true">/</i>
            <span>@Post.Published.ToString("yyyy-MM-dd")</span>
            <i aria-hidden="true">/</i>
            <span>@Post.ReadTimeMinutes min</span>
            @if (!string.IsNullOrEmpty(Post.Category))
            {
                <i aria-hidden="true">/</i>
                <span>@Post.Category</span>
            }
            @if (Post.Featured)
            {
                <i aria-hidden="true">/</i>
                <span style="color:var(--zafaran)">lead</span>
            }
        </p>
        <h3>@Post.Title</h3>
        <p class="line-clamp-2">@Post.Description</p>
    </a>
    @if (Post.Tags.Count > 0)
    {
        <div class="node-tags">
            @foreach (var tag in Post.Tags)
            {
                <a class="chip" href="@(Base)/tags/@tag/">#@tag</a>
            }
        </div>
    }
</article>

@code {
    [Parameter] public required PostSummary Post { get; set; }
    [Parameter] public string Base { get; set; } = "";
    [Parameter] public int Index { get; set; } = 1;
}
