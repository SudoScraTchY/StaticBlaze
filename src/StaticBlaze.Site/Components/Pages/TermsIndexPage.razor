@* Tag or category index, drawn as a weight field so density is visible rather than implied. *@
<SitePage Site=@Site Title=@Label Description=@PageDescription Canonical=@CanonicalPath
          SceneData=@SceneData PostsJson=@PostsJson>
    <section class="sec wrap" style="padding-block-end:2rem">
        <p class="eyebrow"><b>01</b>@Label.ToLowerInvariant()</p>
        <h1 class="mt-4" style="font-size:var(--fs-xl)">@Terms.Count terms, weighted.</h1>
    </section>

    <section class="wrap" style="padding-block-end:clamp(3rem,7vw,6rem)">
        <div class="field">
            @foreach (var term in Terms)
            {
                <a class="field-row" href="@(B)/@Kind/@term.Slug/">
                    <span style="display:flex;align-items:baseline;gap:.5rem;min-width:0">
                        <span style="font-size:var(--fs-sm);font-weight:500">@term.Title</span>
                    </span>
                    <span class="field-bar"><i style="--w:@(Percent(term.Count))%;width:@(Percent(term.Count))%"></i></span>
                    <span class="field-n">@term.Count</span>
                </a>
            }
        </div>
    </section>
</SitePage>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required string Kind { get; set; }
    [Parameter] public required string Label { get; set; }
    [Parameter] public required IReadOnlyList<TermCount> Terms { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    private string CanonicalPath => $"/{Kind}/";
    private string B => Site.BasePath;
    private string PageDescription => $"{Terms.Count} {Label.ToLowerInvariant()} on {Site.Title}, each weighted by how many posts carry it. Browse by subject instead of by date.";

    private int MaxCount => Terms.Count == 0 ? 0 : Terms.Max(t => t.Count);
    private int Percent(int count) => MaxCount <= 0 ? 0 : Math.Max(8, (int)Math.Round(count * 100.0 / MaxCount));
}
