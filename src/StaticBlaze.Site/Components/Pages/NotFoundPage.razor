<SitePage Site=@Site Title="Signal lost" Description="That address does not resolve on this site. Recovery paths for a dead link: the index, the archive, or search." Canonical="/404.html" SceneData=@SceneData PostsJson=@PostsJson>
        <section class="sec wrap" style="text-align:center">
            <p class="eyebrow" style="justify-content:center"><b>404</b> no signal at this address</p>
            <h1 class="mt-5" style="font-size:var(--fs-xl)">The path you followed leads nowhere on this site.</h1>
            <p class="mt-4" style="color:var(--ink-dim);max-width:52ch;margin-inline:auto">
                Nothing is broken on your end. The route simply is not in the field.
                Try the index, or search the archive.
            </p>
            <div class="mt-8" style="display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap">
                <a class="btn btn-solid" href="@(B)/posts/">open the index</a>
                <a class="btn" href="@(B)/archive/">browse the archive</a>
                <button type="button" class="btn" data-cmd-open>search</button>
            </div>
        </section>
    </SitePage>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    private string B => Site.BasePath;
}
