@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <header class="border-b border-line sticky top-0 bg-bg/95 z-40">
        <div class="mx-auto max-w-5xl px-5 sm:px-8">
            <div class="flex h-14 items-center justify-between gap-4">
                <div class="flex items-center gap-6">
                    <a href="/" class="flex items-center gap-2.5" aria-label="back to site">
                        <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="M12 2.5 20.2 7.25v9.5L12 21.5 3.8 16.75v-9.5L12 2.5Z" />
                            <path d="M12 7.5 16 9.75v4.5L12 16.5 8 14.25v-4.5L12 7.5Z" />
                        </svg>
                        <span class="font-mono text-xs tracking-widest uppercase text-muted">admin</span>
                    </a>
                    @if (Auth.Authed)
                    {
                        <nav class="flex items-center gap-5 font-mono text-xs tracking-widest uppercase">
                            <NavLink class="text-muted hover:text-accent transition-colors duration-150" ActiveClass="text-accent" href="dashboard">dashboard</NavLink>
                            <NavLink class="text-muted hover:text-accent transition-colors duration-150" ActiveClass="text-accent" href="posts">posts</NavLink>
                            <NavLink class="text-muted hover:text-accent transition-colors duration-150" ActiveClass="text-accent" href="media">media</NavLink>
                            <NavLink class="text-muted hover:text-accent transition-colors duration-150" ActiveClass="text-accent" href="settings">settings</NavLink>
                        </nav>
                    }
                </div>
                <div class="flex items-center gap-4">
                    @if (Auth.Authed && Auth.Identity is { } identity)
                    {
                        <span class="font-mono text-xs text-muted hidden sm:inline">@@@identity.Login</span>
                        <button type="button" class="btn" @onclick="LockAsync">lock</button>
                    }
                </div>
            </div>
        </div>
        <div class="tile-rule opacity-60" aria-hidden="true"></div>
    </header>

    <main class="flex-1 mx-auto w-full max-w-5xl px-5 sm:px-8 py-8 sm:py-10">
        @Body
    </main>

    <footer class="border-t border-line">
        <div class="mx-auto max-w-5xl px-5 sm:px-8 py-4 font-mono text-xs text-muted">
            StaticBlaze admin · GitHub is the database
        </div>
    </footer>
</div>

@code {
    private async Task LockAsync()
    {
        await Auth.LockAsync();
        Nav.NavigateTo("unlock");
    }
}
