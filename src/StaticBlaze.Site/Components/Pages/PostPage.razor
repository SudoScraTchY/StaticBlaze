@* Article. The header carries a per-post wireframe signal rendered by three.js, so every article has
   its own geometry, seeded from the slug. The reading rail is driven by ScrollTrigger, not a scroll listener. *@
<SitePage Site=@Site Title=@Post.Title Description=@Post.Frontmatter.Description Canonical=@Post.Url
          OgType="article" OgImage=@Post.Frontmatter.Thumbnail JsonLd=@JsonLd ShowRail="true"
          SceneData=@SceneData PostsJson=@PostsJson PostGraph=@PostGraph>
    <article class="wrap" style="padding-block:clamp(2rem,5vw,4rem)">
        <header class="split split-8-4" style="align-items:start">
            <div>
                <p class="eyebrow mb-4"><b>@Month</b>@Post.Frontmatter.Category</p>
                <h1 style="font-size:var(--fs-xl);max-width:26ch">@Post.Title</h1>
                <p class="mt-5" style="color:var(--ink-dim);max-width:58ch;font-size:var(--fs-md)">@Post.Frontmatter.Description</p>
                <div class="tile-rule" style="height:1px;background:linear-gradient(90deg,var(--lajvard),var(--accent),transparent);margin-block-start:1.5rem"></div>
                <p class="node-meta mt-4">
                    <a href="@(B)/authors/@Post.Frontmatter.Author/" style="color:var(--accent);text-decoration:none">@("@")@AuthorHandle</a>
                    <i aria-hidden="true">/</i>
                    <span>@Post.Frontmatter.Published.ToString("yyyy-MM-dd")</span>
                    <i aria-hidden="true">/</i>
                    <span>@Post.ReadTimeMinutes min read</span>
                    @if (Post.Frontmatter.Modified is { } modified)
                    {
                        <i aria-hidden="true">/</i>
                        <span>updated @modified.ToString("yyyy-MM-dd")</span>
                    }
                </p>
            </div>
            @* Related-posts graph. The current post is the central node; every post linked inside the
               article body is a redirecting node. The list below is the no-JS fallback (real links,
               crawlable); graph.js upgrades it into the SVG graph when JS runs. *@
            <div class="panel" data-post-graph style="aspect-ratio:4/3;position:relative;overflow:hidden">
                <span class="panel-head" style="border:0;position:absolute;inset-block-start:0;inset-inline:0;z-index:2">
                    <span>graph</span><span>@Post.Frontmatter.Slug</span>
                </span>
                <div class="graph-stage" data-graph-stage style="position:absolute;inset:0">
                    @if (LinkedPosts.Count == 0)
                    {
                        <p class="graph-empty" data-graph-empty>no posts linked inside this article yet</p>
                    }
                    else
                    {
                        <ul class="graph-fallback" data-graph-fallback>
                            @foreach (var link in LinkedPosts)
                            {
                                <li><a href="@(B + link.Url)">@link.Title</a></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </header>

        @if (Post.Frontmatter.Thumbnail is { } thumb)
        {
            <img src="@(B)/@thumb" alt="@Post.Title" style="width:100%;border:1px solid var(--edge);border-radius:var(--r-2);margin-block:2.5rem" loading="lazy" />
        }

        <div class="split split-8-4" style="margin-block-start:3rem;align-items:start">
            <div class="prose">@((MarkupString)Post.Html)</div>
            <div class="sticky-side">
                <div class="panel">
                    <p class="panel-head"><span>in this file</span><span>@Post.WordCount w</span></p>
                    <div style="padding:1rem">
                        @if (Headings.Count > 0)
                        {
                            <ol style="list-style:none;margin:0;padding:0;display:grid;gap:.5rem">
                                @foreach (var h in Headings)
                                {
                                    <li>
                                        <a href="#@h.Id" style="font-size:var(--fs-xs);color:var(--ink-dim);text-decoration:none">@h.Text</a>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p class="form-note">Short note. No sections to index.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Post.Frontmatter.Tags.Count > 0)
        {
            <div style="margin-block-start:3rem;padding-block-start:1.5rem;border-block-start:1px solid var(--edge);display:flex;flex-wrap:wrap;gap:.4rem">
                @foreach (var tag in Post.Frontmatter.Tags)
                {
                    <a class="chip" href="@(B)/tags/@tag/">#@tag</a>
                }
            </div>
        }

        @if (Author is not null)
        {
            <div class="panel" style="margin-block-start:2.5rem;padding:1.25rem;display:flex;gap:1.1rem;align-items:flex-start">
                @if (Author.Avatar is { } avatar)
                {
                    <img src="@(B)/@avatar" alt=@Author.Name style="width:52px;height:52px;border-radius:var(--r-2);border:1px solid var(--edge);object-fit:cover" loading="lazy" />
                }
                <div style="min-width:0">
                    <p style="font-weight:500">@Author.Name <span class="form-note">@("@")@Author.Handle</span></p>
                    @if (!string.IsNullOrEmpty(Author.Bio))
                    {
                        <p style="font-size:var(--fs-sm);color:var(--ink-dim);margin-block-start:.3rem">@Author.Bio</p>
                    }
                </div>
            </div>
        }

        @if (Related.Count > 0)
        {
            <section style="margin-block-start:3.5rem">
                <p class="eyebrow mb-6"><b>05</b>adjacent</p>
                <div class="grid-nodes">
                    @for (var i = 0; i < Related.Count; i++)
                    {
                        <PostCard Post=@Related[i] Base=@B Index=@(i + 1) />
                    }
                </div>
            </section>
        }
    @* Comments via GitHub Discussions (giscus). Rendered only when site.json configures it, so
       an unconfigured blog shows nothing at all rather than a broken widget. The section is
       written with data-* attributes; site.js mounts the iframe when the config is complete. *@
    @if (Comments is { Enabled: true })
    {
        var c = Comments;
        <section class="comments" data-comments
                 data-repo="@c.Repo" data-repo-id="@c.RepoId" data-category="@c.Category"
                 data-category-id="@c.CategoryId" data-mapping="@c.Mapping"
                 data-theme="@c.Theme" data-lang="@c.Lang">
            <p class="eyebrow"><b>06</b>comments</p>
            <div class="comments-frame" data-comments-frame>
                <p class="form-note">Comments load from GitHub Discussions. They appear once giscus is configured in <code>content/site.json</code>.</p>
            </div>
        </section>
    }    </article>
</SitePage>

@code {
    [Parameter] public System.Collections.Generic.IReadOnlyList<StaticBlaze.Core.Models.PostSummary> LinkedPosts { get; set; } = System.Array.Empty<StaticBlaze.Core.Models.PostSummary>();
    [Parameter] public StaticBlaze.Core.Models.GiscusConfig? Comments { get; set; }
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required Post Post { get; set; }
    [Parameter] public AuthorRecord? Author { get; set; }
    [Parameter] public string CategoryTitle { get; set; } = "";
    [Parameter] public required IReadOnlyList<PostSummary> Related { get; set; }
    [Parameter] public string? PostGraph { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    private string B => Site.BasePath;
    private string AuthorHandle => Author?.Handle ?? Post.Frontmatter.Author;
    private string Month => Post.Frontmatter.Published.ToString("MM");

    private sealed record Head(string Id, string Text);

    // Built from the rendered HTML so the index matches what the reader actually sees.
    private IReadOnlyList<Head> Headings => _headings ??= ExtractHeadings(Post.Html);
    private IReadOnlyList<Head>? _headings;

    private static IReadOnlyList<Head> ExtractHeadings(string html)
    {
        var found = new List<Head>();
        foreach (System.Text.RegularExpressions.Match m in
                 System.Text.RegularExpressions.Regex.Matches(html, "<h2[^>]*id=\"(?<id>[^\"]+)\"[^>]*>(?<text>.*?)</h2>",
                     System.Text.RegularExpressions.RegexOptions.Singleline))
        {
            var text = System.Text.RegularExpressions.Regex.Replace(m.Groups["text"].Value, "<[^>]+>", "").Trim();
            if (text.Length > 0) found.Add(new Head(m.Groups["id"].Value, text));
        }
        return found;
    }

    private string JsonLd => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BlogPosting",
        ["headline"] = Post.Title,
        ["description"] = Post.Frontmatter.Description,
        ["datePublished"] = Post.Frontmatter.Published.ToString("yyyy-MM-ddTHH:mm:ssK"),
        ["dateModified"] = (Post.Frontmatter.Modified ?? Post.Frontmatter.Published).ToString("yyyy-MM-ddTHH:mm:ssK"),
        ["wordCount"] = Post.WordCount,
        ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = Author?.Name ?? Post.Frontmatter.Author },
        ["mainEntityOfPage"] = Site.Url.TrimEnd('/') + Post.Url,
    }, StaticBlazeJson.Options);
}
