@* One tag or category. *@
<SitePage Site=@Site Title="@($"{Label}: {Term.Title}")" Description=@PageDescription Canonical=@CanonicalPath
          SceneData=@SceneData PostsJson=@PostsJson>
    <section class="sec wrap" style="padding-block-end:2rem">
        <p class="eyebrow mb-3"><a href="@(B)/@Kind/" style="color:inherit;text-decoration:none">@Label.ToLowerInvariant()</a> <b>@Count</b></p>
        <h1 style="font-size:var(--fs-xl)">@Term.Title</h1>
        @if (!string.IsNullOrEmpty(Term.Description))
        {
            <p class="mt-4" style="color:var(--ink-dim);max-width:56ch">@Term.Description</p>
        }
    </section>

    <section class="wrap" style="padding-block-end:clamp(3rem,7vw,6rem)">
        <div class="grid-nodes">
            @for (var i = 0; i < Posts.Count; i++)
            {
                <PostCard Post=@Posts[i] Base=@B Index=@(i + 1) />
            }
        </div>
        <Pagination Page=@Page TotalPages=@TotalPages BasePath=@($"{B}/{Kind}/{Term.Slug}/") />
    </section>
</SitePage>

@code {
    [Parameter] public required SiteConfig Site { get; set; }
    [Parameter] public required string Kind { get; set; }
    [Parameter] public required string Label { get; set; }
    [Parameter] public required TaxonomyTerm Term { get; set; }
    [Parameter] public required int Count { get; set; }
    [Parameter] public required IReadOnlyList<PostSummary> Posts { get; set; }
    [Parameter] public required int Page { get; set; }
    [Parameter] public required int TotalPages { get; set; }
    [Parameter] public string? SceneData { get; set; }
    [Parameter] public string PostsJson { get; set; } = """{"posts":[]}""";

    private string B => Site.BasePath;
    private string CanonicalPath => Page <= 1 ? $"/{Kind}/{Term.Slug}/" : $"/{Kind}/{Term.Slug}/page/{Page}/";
    private string PageDescription => !string.IsNullOrWhiteSpace(Term.Description) && Term.Description.Length >= 60
        ? Term.Description
        : $"{Count} {(Count == 1 ? "post" : "posts")} filed under {Term.Title} on {Site.Title}. {Label.ToLowerInvariant()} index for this blog, newest first.";
}
